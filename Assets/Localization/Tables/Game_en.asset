    m_Metadata:
      m_Items: []
  - m_Id: 8270589452318
    m_Localized: Your {0} broke
    m_Metadata:
      m_Items: []
  - m_Id: 8270589452319
    m_Localized: There's no room for {0} x {1} in your inventory
    m_Metadata:
      m_Items: []
  - m_Id: 8270589452320
    m_Localized: 'You were hurt: the parts lister closed'
    m_Metadata:
      m_Items: []
  - m_Id: 8270589452321
