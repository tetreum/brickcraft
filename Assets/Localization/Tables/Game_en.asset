    m_Metadata:
      m_Items: []
  - m_Id: 8270589452309
    m_Localized: You can't sleep now, something is after you
    m_Metadata:
      m_Items: []
  - m_Id: 8270589452310
    m_Localized: 'Spawn point set: you''ll come back to this bed'
    m_Metadata:
      m_Items: []
  - m_Id: 8270589452311
    m_Localized: 'Your bed is gone: you lost your spawn point'
    m_Metadata:
      m_Items: []
  - m_Id: 8270589452312
    m_Localized: The night was slept through. Good morning!
    m_Metadata:
      m_Items: []
  - m_Id: 8270589452313
    m_Localized: The {0} is yours now. Use it again for its orders.
    m_Metadata:
      m_Items: []
  - m_Id: 8270589452314
    m_Localized: 'It''s locked: only its owner can open it'
    m_Metadata:
      m_Items: []
  - m_Id: 8270589452315
